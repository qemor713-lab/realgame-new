{
  "title": "Game Mobile Legends (big Update)",
  "description": "",
  "head": "<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
  "htmlAttrs": "lang=\"en\" class=\"\"",
  "tags": [],
  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\" />\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n<title>Mini Game Mobile Legends - Tombol Main</title>\r\n<style>\r\n  body {\r\n    font-family: Arial, sans-serif;\r\n    background-color: #222;\r\n    color: #fff;\r\n    margin: 0;\r\n    overflow: hidden;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    height: 100vh;\r\n  }\r\n  #gameArea {\r\n    position: relative;\r\n    width: 100vw;\r\n    height: 100vh;\r\n    background-color: #444;\r\n    display: none; /* Sembunyikan area game secara default */\r\n    z-index: 2; /* Pastikan game di atas elemen lain */\r\n  }\r\n  .player, .enemy, .special-enemy, .super-special-enemy {\r\n    position: absolute;\r\n    width: 40px;\r\n    height: 40px;\r\n    border-radius: 50%;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    font-weight: bold;\r\n    color: #fff;\r\n  }\r\n  #player {\r\n    background-color: #4CAF50;\r\n  }\r\n  .enemy {\r\n    background-color: #f44336; /* Merah */\r\n  }\r\n  .special-enemy {\r\n    background-color: #FFA500; /* Oranye */\r\n  }\r\n  .super-special-enemy {\r\n    background-color: #000000; /* Hitam */\r\n  }\r\n  #points {\r\n    position: absolute;\r\n    top: 10px;\r\n    left: 10px;\r\n    font-size: 20px;\r\n    z-index: 10;\r\n  }\r\n  #status {\r\n    position: absolute;\r\n    top: 40px;\r\n    left: 10px;\r\n    font-size: 18px;\r\n    z-index: 10;\r\n  }\r\n\r\n  /* Loading Screen Styles */\r\n  #loadingScreen {\r\n    position: absolute; /* Agar bisa ditumpuk di atas gameArea */\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    background-color: #222; /* Sama dengan warna body */\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: center;\r\n    align-items: center;\r\n    z-index: 100; /* Pastikan loading screen di paling atas */\r\n    transition: opacity 0.5s ease-out; /* Transisi saat menghilang */\r\n  }\r\n  #progressBarContainer {\r\n    width: 80%;\r\n    max-width: 500px;\r\n    height: 30px;\r\n    background-color: #555;\r\n    border-radius: 5px;\r\n    margin: 20px auto;\r\n    overflow: hidden;\r\n  }\r\n  #progressBar {\r\n    height: 100%;\r\n    width: 0%;\r\n    background-color: #4CAF50;\r\n    border-radius: 5px;\r\n    transition: width 0.1s linear;\r\n  }\r\n  #loadingText {\r\n    font-size: 24px;\r\n    font-weight: bold;\r\n  }\r\n  #playButton {\r\n    padding: 15px 30px;\r\n    font-size: 24px;\r\n    font-weight: bold;\r\n    background-color: #f44336; /* Warna merah untuk tombol play */\r\n    color: white;\r\n    border: none;\r\n    border-radius: 8px;\r\n    cursor: pointer;\r\n    margin-top: 20px;\r\n    opacity: 0; /* Sembunyikan tombol play secara default */\r\n    transition: opacity 0.5s ease-in;\r\n    z-index: 101; /* Di atas loading screen */\r\n  }\r\n  #playButton:hover {\r\n    background-color: #d32f2f; /* Warna lebih gelap saat hover */\r\n  }\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<div id=\"loadingScreen\">\r\n  <div id=\"loadingText\">Loading... 0%</div>\r\n  <div id=\"progressBarContainer\">\r\n    <div id=\"progressBar\"></div>\r\n  </div>\r\n  <button id=\"playButton\">Main!!!</button>\r\n</div>\r\n\r\n<div id=\"gameArea\">\r\n  <div id=\"player\" class=\"player\">you</div>\r\n  <div id=\"points\">Points: 0</div>\r\n  <div id=\"status\">Tekan 'F' untuk serang, 'WASD' untuk bergerak, 'P' lihat poin, 'R' restart</div>\r\n</div>\r\n\r\n<script>\r\n  const gameArea = document.getElementById('gameArea');\r\n  const loadingScreen = document.getElementById('loadingScreen');\r\n  const loadingText = document.getElementById('loadingText');\r\n  const progressBar = document.getElementById('progressBar');\r\n  const playButton = document.getElementById('playButton');\r\n\r\n  const player = document.getElementById('player');\r\n  const pointsDisplay = document.getElementById('points');\r\n  const status = document.getElementById('status');\r\n\r\n  // Konstanta game\r\n  const NUM_NORMAL_ENEMIES = 30;\r\n  const SPECIAL_ENEMY_POINTS = 4500;\r\n  const SUPER_SPECIAL_ENEMY_POINTS = 45000;\r\n  const ENEMY_SIZE = 40;\r\n  const PLAYER_SPEED = 3;\r\n  const ENEMY_ATTACK_RANGE = 50;\r\n  const ENEMY_ATTACK_INTERVAL = 1000;\r\n  const LOADING_DURATION = 2000; // Durasi loading dalam milidetik (2 detik)\r\n\r\n  let points = localStorage.getItem('points') ? parseInt(localStorage.getItem('points')) : 0;\r\n  let keysPressed = {};\r\n  let enemies = [];\r\n  let playerPos = { x: window.innerWidth/2, y: window.innerHeight/2 };\r\n\r\n  // --- Fungsi Loading ---\r\n  function updateLoading(percentage) {\r\n    loadingText.innerText = `Loading... ${Math.round(percentage)}%`;\r\n    progressBar.style.width = `${percentage}%`;\r\n  }\r\n\r\n  function showPlayButton() {\r\n    playButton.style.opacity = '1'; // Tampilkan tombol play\r\n    playButton.style.display = 'block'; // Pastikan tombol terlihat\r\n  }\r\n\r\n  function hideLoadingScreen() {\r\n    loadingScreen.style.opacity = '0'; // Transisi menghilang\r\n    loadingScreen.style.pointerEvents = 'none'; // Nonaktifkan interaksi saat menghilang\r\n    gameArea.style.display = 'block'; // Tampilkan area game\r\n  }\r\n\r\n  function startLoading() {\r\n    let progress = 0;\r\n    const interval = setInterval(() => {\r\n      progress += 1;\r\n      updateLoading(progress);\r\n      if (progress >= 100) {\r\n        clearInterval(interval);\r\n        showPlayButton(); // Tampilkan tombol play setelah loading 100%\r\n      }\r\n    }, LOADING_DURATION / 100);\r\n  }\r\n\r\n  // --- Fungsi Game ---\r\n  function getRandomPosition() {\r\n    const x = Math.random() * (window.innerWidth - ENEMY_SIZE);\r\n    const y = Math.random() * (window.innerHeight - ENEMY_SIZE);\r\n    return { x, y };\r\n  }\r\n\r\n  function initEnemies() {\r\n    enemies = [];\r\n    document.querySelectorAll('.enemy, .special-enemy, .super-special-enemy').forEach(e => e.remove());\r\n\r\n    for (let i = 0; i < NUM_NORMAL_ENEMIES; i++) {\r\n      const el = document.createElement('div');\r\n      el.className = 'enemy';\r\n      el.innerText = 'E' + (i + 1);\r\n      gameArea.appendChild(el);\r\n      const pos = getRandomPosition();\r\n      el.style.left = pos.x + 'px';\r\n      el.style.top = pos.y + 'px';\r\n      enemies.push({ element: el, x: pos.x, y: pos.y, alive: true, isSpecial: false, isSuperSpecial: false });\r\n    }\r\n\r\n    const specialEl = document.createElement('div');\r\n    specialEl.className = 'special-enemy';\r\n    specialEl.innerText = 'SP';\r\n    gameArea.appendChild(specialEl);\r\n    const specialPos = getRandomPosition();\r\n    specialEl.style.left = specialPos.x + 'px';\r\n    specialEl.style.top = specialPos.y + 'px';\r\n    enemies.push({ element: specialEl, x: specialPos.x, y: specialPos.y, alive: true, isSpecial: true, isSuperSpecial: false });\r\n\r\n    const superSpecialEl = document.createElement('div');\r\n    superSpecialEl.className = 'super-special-enemy';\r\n    superSpecialEl.innerText = 'SS';\r\n    gameArea.appendChild(superSpecialEl);\r\n    const superSpecialPos = getRandomPosition();\r\n    superSpecialEl.style.left = superSpecialPos.x + 'px';\r\n    superSpecialEl.style.top = superSpecialPos.y + 'px';\r\n    enemies.push({ element: superSpecialEl, x: superSpecialPos.x, y: superSpecialPos.y, alive: true, isSpecial: false, isSuperSpecial: true });\r\n  }\r\n\r\n  function updatePlayerPosition() {\r\n    player.style.left = playerPos.x + 'px';\r\n    player.style.top = playerPos.y + 'px';\r\n  }\r\n\r\n  function updatePointsDisplay() {\r\n    pointsDisplay.innerText = 'Points: ' + points;\r\n  }\r\n\r\n  function gameLoop() {\r\n    if (keysPressed['w']) playerPos.y -= PLAYER_SPEED;\r\n    if (keysPressed['s']) playerPos.y += PLAYER_SPEED;\r\n    if (keysPressed['a']) playerPos.x -= PLAYER_SPEED;\r\n    if (keysPressed['d']) playerPos.x += PLAYER_SPEED;\r\n\r\n    if (playerPos.x < 0) playerPos.x = 0;\r\n    if (playerPos.y < 0) playerPos.y = 0;\r\n    if (playerPos.x > window.innerWidth - ENEMY_SIZE) playerPos.x = window.innerWidth - ENEMY_SIZE;\r\n    if (playerPos.y > window.innerHeight - ENEMY_SIZE) playerPos.y = window.innerHeight - ENEMY_SIZE;\r\n\r\n    updatePlayerPosition();\r\n    requestAnimationFrame(gameLoop);\r\n  }\r\n\r\n  document.addEventListener('keydown', (e) => {\r\n    const key = e.key.toLowerCase();\r\n    keysPressed[key] = true;\r\n    if (key === 'f') {\r\n      attack();\r\n    } else if (key === 'p') {\r\n      alert('Poin kamu: ' + points);\r\n    } else if (key === 'r') {\r\n      restartGame();\r\n    }\r\n  });\r\n\r\n  document.addEventListener('keyup', (e) => {\r\n    keysPressed[e.key.toLowerCase()] = false;\r\n  });\r\n\r\n  function attack() {\r\n    enemies.forEach(e => {\r\n      if (e.alive && isNear(playerPos, e)) {\r\n        e.alive = false;\r\n        e.element.style.display = 'none';\r\n\r\n        let pointsGained = 1;\r\n        let message = 'Kamu mengalahkan lawan.';\r\n\r\n        if (e.isSuperSpecial) {\r\n          pointsGained = SUPER_SPECIAL_ENEMY_POINTS;\r\n          message = 'Kamu mengalahkan LAWAN SUPER SPESIAL!!!';\r\n        } else if (e.isSpecial) {\r\n          pointsGained = SPECIAL_ENEMY_POINTS;\r\n          message = 'Kamu mengalahkan LAWAN SPESIAL!';\r\n        }\r\n\r\n        points += pointsGained;\r\n        localStorage.setItem('points', points);\r\n        updatePointsDisplay();\r\n        status.innerText = message;\r\n\r\n        setTimeout(() => {\r\n          const remainingEnemies = enemies.filter(en => en.alive);\r\n          if (remainingEnemies.length > 0) {\r\n            status.innerText = 'Lawan menyerang kamu!';\r\n          } else {\r\n            status.innerText = 'Semua lawan dikalahkan! Tekan R untuk restart.';\r\n          }\r\n        }, 500);\r\n      }\r\n    });\r\n  }\r\n\r\n  function isNear(pos1, enemy) {\r\n    const dx = pos1.x - enemy.x;\r\n    const dy = pos1.y - enemy.y;\r\n    return Math.sqrt(dx*dx + dy*dy) < ENEMY_ATTACK_RANGE;\r\n  }\r\n\r\n  setInterval(() => {\r\n    enemies.forEach(e => {\r\n      if (e.alive && isNear(playerPos, e)) {\r\n        status.innerText = 'Kamu diserang oleh ' + e.element.innerText;\r\n      }\r\n    });\r\n  }, ENEMY_ATTACK_INTERVAL);\r\n\r\n  function restartGame() {\r\n    playerPos = { x: window.innerWidth/2, y: window.innerHeight/2 };\r\n    updatePlayerPosition();\r\n    initEnemies();\r\n    status.innerText = 'Game di-restart!';\r\n  }\r\n\r\n  window.addEventListener('resize', () => {\r\n    if (playerPos.x > window.innerWidth - ENEMY_SIZE) playerPos.x = window.innerWidth - ENEMY_SIZE;\r\n    if (playerPos.y > window.innerHeight - ENEMY_SIZE) playerPos.y = window.innerHeight - ENEMY_SIZE;\r\n    updatePlayerPosition();\r\n  });\r\n\r\n  // Event listener untuk tombol \"Main!!!\"\r\n  playButton.addEventListener('click', () => {\r\n    hideLoadingScreen();\r\n    // Inisialisasi game hanya setelah tombol \"Main!!!\" diklik\r\n    initEnemies();\r\n    updatePlayerPosition();\r\n    updatePointsDisplay();\r\n    requestAnimationFrame(gameLoop); // Mulai game loop\r\n  });\r\n\r\n  // Mulai proses loading saat halaman dimuat\r\n  startLoading();\r\n</script>\r\n</body>\r\n</html>"
  },
