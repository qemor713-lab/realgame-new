{
  "title": "Game Mobile Legends v4",
  "description": "",
  "head": "<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
  "htmlAttrs": "lang=\"en\" class=\"\"",
  "tags": [],
  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\" />\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n<title>Mini Game Mobile Legends - Lawan Spesial</title>\r\n<style>\r\n  body {\r\n    font-family: Arial, sans-serif;\r\n    background-color: #222;\r\n    color: #fff;\r\n    margin: 0;\r\n    overflow: hidden;\r\n  }\r\n  #gameArea {\r\n    position: relative;\r\n    width: 100vw;\r\n    height: 100vh;\r\n    background-color: #444;\r\n  }\r\n  .player, .enemy, .special-enemy {\r\n    position: absolute;\r\n    width: 40px;\r\n    height: 40px;\r\n    border-radius: 50%;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    font-weight: bold;\r\n    color: #fff;\r\n  }\r\n  #player {\r\n    background-color: #4CAF50;\r\n    top: 50%;\r\n    left: 50%;\r\n    transform: translate(-50%, -50%);\r\n  }\r\n  .enemy {\r\n    background-color: #f44336; /* Merah untuk lawan biasa */\r\n  }\r\n  .special-enemy {\r\n    background-color: #FFA500; /* Oranye untuk lawan spesial */\r\n  }\r\n  #points {\r\n    position: absolute;\r\n    top: 10px;\r\n    left: 10px;\r\n    font-size: 20px;\r\n  }\r\n  #status {\r\n    position: absolute;\r\n    top: 40px;\r\n    left: 10px;\r\n    font-size: 18px;\r\n  }\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<div id=\"gameArea\">\r\n  <div id=\"player\" class=\"player\">P</div>\r\n</div>\r\n<div id=\"points\">Points: 0</div>\r\n<div id=\"status\">Tekan 'F' untuk serang, 'WASD' untuk bergerak, 'P' lihat poin, 'R' restart</div>\r\n\r\n<script>\r\nconst gameArea = document.getElementById('gameArea');\r\nconst player = document.getElementById('player');\r\nconst pointsDisplay = document.getElementById('points');\r\nconst status = document.getElementById('status');\r\n\r\nlet points = localStorage.getItem('points') ? parseInt(localStorage.getItem('points')) : 0;\r\nlet keysPressed = {};\r\n\r\n// Posisi pemain\r\nlet playerPos = { x: window.innerWidth/2, y: window.innerHeight/2 };\r\nlet enemies = []; // Array untuk menyimpan semua lawan (biasa dan spesial)\r\n\r\nconst NUM_NORMAL_ENEMIES = 30; // Jumlah lawan biasa\r\nconst SPECIAL_ENEMY_POINTS = 4500; // Poin dari lawan spesial\r\nconst ENEMY_SIZE = 40;\r\nconst PLAYER_SPEED = 3;\r\nconst ENEMY_ATTACK_RANGE = 50;\r\nconst ENEMY_ATTACK_INTERVAL = 1000;\r\n\r\n// Fungsi untuk mendapatkan posisi acak di dalam game area\r\nfunction getRandomPosition() {\r\n  const x = Math.random() * (window.innerWidth - ENEMY_SIZE);\r\n  const y = Math.random() * (window.innerHeight - ENEMY_SIZE);\r\n  return { x, y };\r\n}\r\n\r\n// Fungsi untuk inisialisasi semua lawan\r\nfunction initEnemies() {\r\n  enemies = [];\r\n  // Hapus lawan sebelumnya dari DOM\r\n  document.querySelectorAll('.enemy, .special-enemy').forEach(e => e.remove());\r\n\r\n  // Buat lawan biasa\r\n  for (let i = 0; i < NUM_NORMAL_ENEMIES; i++) {\r\n    const el = document.createElement('div');\r\n    el.className = 'enemy';\r\n    el.innerText = 'E' + (i + 1);\r\n    gameArea.appendChild(el);\r\n    const pos = getRandomPosition();\r\n    el.style.left = pos.x + 'px';\r\n    el.style.top = pos.y + 'px';\r\n    enemies.push({ element: el, x: pos.x, y: pos.y, alive: true, isSpecial: false });\r\n  }\r\n\r\n  // Buat lawan spesial\r\n  const specialEl = document.createElement('div');\r\n  specialEl.className = 'special-enemy';\r\n  specialEl.innerText = 'SP'; // Label untuk lawan spesial\r\n  gameArea.appendChild(specialEl);\r\n  const specialPos = getRandomPosition();\r\n  specialEl.style.left = specialPos.x + 'px';\r\n  specialEl.style.top = specialPos.y + 'px';\r\n  enemies.push({ element: specialEl, x: specialPos.x, y: specialPos.y, alive: true, isSpecial: true });\r\n}\r\n\r\n// Update posisi pemain di DOM\r\nfunction updatePlayerPosition() {\r\n  player.style.left = playerPos.x + 'px';\r\n  player.style.top = playerPos.y + 'px';\r\n}\r\n\r\n// Inisialisasi game saat pertama kali dimuat\r\ninitEnemies();\r\nupdatePlayerPosition();\r\nupdatePointsDisplay();\r\n\r\n// Update tampilan poin\r\nfunction updatePointsDisplay() {\r\n  pointsDisplay.innerText = 'Points: ' + points;\r\n}\r\n\r\n// Game loop untuk gerakan yang mulus\r\nfunction gameLoop() {\r\n  // Gerakan pemain berdasarkan tombol yang ditekan\r\n  if (keysPressed['w']) playerPos.y -= PLAYER_SPEED;\r\n  if (keysPressed['s']) playerPos.y += PLAYER_SPEED;\r\n  if (keysPressed['a']) playerPos.x -= PLAYER_SPEED;\r\n  if (keysPressed['d']) playerPos.x += PLAYER_SPEED;\r\n\r\n  // Batasi posisi pemain agar tidak keluar layar\r\n  if (playerPos.x < 0) playerPos.x = 0;\r\n  if (playerPos.y < 0) playerPos.y = 0;\r\n  if (playerPos.x > window.innerWidth - ENEMY_SIZE) playerPos.x = window.innerWidth - ENEMY_SIZE;\r\n  if (playerPos.y > window.innerHeight - ENEMY_SIZE) playerPos.y = window.innerHeight - ENEMY_SIZE;\r\n\r\n  updatePlayerPosition();\r\n  requestAnimationFrame(gameLoop);\r\n}\r\nrequestAnimationFrame(gameLoop); // Mulai game loop\r\n\r\n// Event listener untuk tombol ditekan\r\ndocument.addEventListener('keydown', (e) => {\r\n  const key = e.key.toLowerCase();\r\n  keysPressed[key] = true;\r\n  if (key === 'f') {\r\n    attack();\r\n  } else if (key === 'p') {\r\n    alert('Poin kamu: ' + points);\r\n  } else if (key === 'r') {\r\n    restartGame();\r\n  }\r\n});\r\n\r\n// Event listener untuk tombol dilepas\r\ndocument.addEventListener('keyup', (e) => {\r\n  keysPressed[e.key.toLowerCase()] = false;\r\n});\r\n\r\n// Fungsi untuk menyerang lawan\r\nfunction attack() {\r\n  enemies.forEach(e => {\r\n    if (e.alive && isNear(playerPos, e)) {\r\n      e.alive = false;\r\n      e.element.style.display = 'none'; // Sembunyikan lawan yang dikalahkan\r\n\r\n      let pointsGained = 1; // Poin default\r\n      if (e.isSpecial) {\r\n        pointsGained = SPECIAL_ENEMY_POINTS;\r\n        status.innerText = 'Kamu mengalahkan LAWAN SPESIAL!';\r\n      } else {\r\n        status.innerText = 'Kamu mengalahkan lawan.';\r\n      }\r\n\r\n      points += pointsGained;\r\n      localStorage.setItem('points', points); // Simpan poin ke localStorage\r\n      updatePointsDisplay();\r\n\r\n      // Beri jeda sebelum status berubah\r\n      setTimeout(() => {\r\n        // Cek apakah masih ada lawan hidup\r\n        const remainingEnemies = enemies.filter(en => en.alive);\r\n        if (remainingEnemies.length > 0) {\r\n          status.innerText = 'Lawan menyerang kamu!';\r\n        } else {\r\n          status.innerText = 'Semua lawan dikalahkan! Tekan R untuk restart.';\r\n        }\r\n      }, 500);\r\n    }\r\n  });\r\n}\r\n\r\n// Cek apakah pemain dekat dengan lawan\r\nfunction isNear(pos1, enemy) {\r\n  const dx = pos1.x - enemy.x;\r\n  const dy = pos1.y - enemy.y;\r\n  // Menggunakan Pythagoras untuk menghitung jarak\r\n  return Math.sqrt(dx*dx + dy*dy) < ENEMY_ATTACK_RANGE;\r\n}\r\n\r\n// Interval untuk membuat lawan menyerang secara otomatis\r\nsetInterval(() => {\r\n  enemies.forEach(e => {\r\n    if (e.alive && isNear(playerPos, e)) {\r\n      status.innerText = 'Kamu diserang oleh ' + e.element.innerText;\r\n      // Di sini bisa ditambahkan logika pengurangan health pemain atau game over\r\n    }\r\n  });\r\n}, ENEMY_ATTACK_INTERVAL);\r\n\r\n// Fungsi untuk me-restart game\r\nfunction restartGame() {\r\n  // Reset posisi pemain ke tengah layar\r\n  playerPos = { x: window.innerWidth/2, y: window.innerHeight/2 };\r\n  updatePlayerPosition();\r\n  // Inisialisasi ulang semua lawan\r\n  initEnemies();\r\n  status.innerText = 'Game di-restart!';\r\n}\r\n\r\n// Handle resize window agar posisi pemain tetap proporsional\r\nwindow.addEventListener('resize', () => {\r\n  // Pastikan pemain tidak keluar dari batas baru layar\r\n  if (playerPos.x > window.innerWidth - ENEMY_SIZE) playerPos.x = window.innerWidth - ENEMY_SIZE;\r\n  if (playerPos.y > window.innerHeight - ENEMY_SIZE) playerPos.y = window.innerHeight - ENEMY_SIZE;\r\n  updatePlayerPosition();\r\n});\r\n</script>\r\n\r\n</body>\r\n</html>"
  },
